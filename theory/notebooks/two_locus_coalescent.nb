Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["2", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "\[Rho]"}], ")"}], "2"]], ",", 
   FractionBox["2", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"3", "+", 
       FractionBox["\[Rho]", "2"]}], ")"}], "2"]], ",", 
