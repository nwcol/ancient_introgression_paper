Cell["\<\
Define the expected jump times from states {1, 2, 3} and their second moments\
\
\>", "Text",
 CellChangeTimes->{{3.9513926060090227`*^9, 
  3.951392643944297*^9}},ExpressionUUID->"858d9a10-0c33-4b3f-aaa9-\
e394a4802703"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"\[Tau]", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"-", 
       RowBox[{"Q", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "i"}], "]"}], "]"}]}], ")"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "3"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"\[Tau]2", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"2", "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", 
        RowBox[{"Q", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "i"}], "]"}], "]"}]}], ")"}], "^", "2"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "3"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.951392625501512*^9, 3.9513927360880823`*^9}, {
  3.951489977614112*^9, 3.951489981359584*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"f6a9a05b-8567-4d9f-a4ee-7fe70b48fe36"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"1", "+", "\[Rho]"}]], ",", 
   FractionBox["1", 
    RowBox[{"3", "+", 
     FractionBox["\[Rho]", "2"]}]], ",", 
   FractionBox["1", "6"]}], "}"}]], "Output",
 CellChangeTimes->{3.9514899819790707`*^9, 3.951555769691668*^9, 
  3.952434930427994*^9},
