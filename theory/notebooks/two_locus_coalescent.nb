Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Q1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[Rho]"}], ")"}]}], ",", "\[Rho]", ",", "0", ",", 
       "0", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"3", "+", 
          RowBox[{"\[Rho]", "/", "2"}]}], ")"}]}], ",", " ", 
       RowBox[{"\[Rho]", "/", "2"}], ",", "1", ",", "1", ",", "0"}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "4", ",", 
       RowBox[{"-", "6"}], ",", "1", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", 
       RowBox[{"-", "1"}], ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
      "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "Q1", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "[", 
   RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"i", "==", "j"}], ",", "0", ",", 
    RowBox[{
     RowBox[{"Q1", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], "]"}], "/", 
     RowBox[{"-", 
      RowBox[{"Q1", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "i"}], "]"}], "]"}]}]}]}], "]"}]}]}], "Input",
