Cell["Define the routing matrix", "Text",
 CellChangeTimes->{{3.951392798967484*^9, 
  3.951392810406769*^9}},ExpressionUUID->"dcabf182-6efe-45d2-ae23-\
9b40681678de"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalLambda]", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Q", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "i"}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{
         RowBox[{"Dimensions", "[", "Q", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "[", 
   RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"i", "==", "j"}], " ", "&&", " ", 
     RowBox[{"i", "<", "4"}]}], ",", "0", ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"i", "==", "j"}], "&&", 
       RowBox[{"i", ">=", "4"}]}], ",", "1", ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"i", "!=", "j"}], "&&", 
         RowBox[{"i", ">=", "4"}]}], ",", "0", ",", 
        RowBox[{
         RowBox[{"Q", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "/", 
         RowBox[{"\[CapitalLambda]", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "i"}], "]"}], "]"}]}]}], "]"}]}], "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"p", "[", 
      RowBox[{"i", ",", "j"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "6"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "P", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Psub", "=", 
   RowBox[{"P", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"1", ";;", "3"}], ",", 
      RowBox[{"1", ";;", "3"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "Psub", "]"}]}], "Input",
 CellChangeTimes->{{3.9513916220085087`*^9, 3.951391707555941*^9}, {
   3.95139191440096*^9, 3.9513919168161497`*^9}, {3.951392980758892*^9, 
