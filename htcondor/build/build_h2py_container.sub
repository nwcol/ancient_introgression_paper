# For building Apptainer container

universe = vanilla
log = reports/build_$(Cluster).log
error = reports/build_$(Cluster).err 
output = reports/build_$(Cluster).out

executable = /usr/bin/hostname

transfer_input_files = h2py_image.def

+IsBuildJob = true
request_cpus = 4
request_memory = 16GB
request_disk = 16GB

queue
