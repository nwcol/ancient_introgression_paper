
log = reports/job_$(Cluster).log
error = reports/job_$(Cluster)_$(Process).err
output = reports/job_$(Cluster)_$(Process).out


requirements = (Target.HasCHTCStaging == true)
container_image = file:///staging/nwcollier/dpluspy-container.sif


executable = simulate_control.sh      


arguments = $(chrom) $(output_vcf) $(output_stats)


should_transfer_files = YES
when_to_transfer_output = ON_EXIT


transfer_input_files = \
    simulate_control.py, \
    ../../data/recombination_maps/Bherer_b37/sexavg_chr$(chrom).txt.gz, \
    ../../data/mutation_maps/roulette_b37_10kb/roulette_10kb_chr$(chrom).csv.gz, \
    ../../data/bed_files/filterbed_1e-4M_exon_buffer/mask_chr$(chrom).bed.gz, \
    ../../data/intervals/1e-4_exon_buffer_1.3Mb/intervals_chr$(chrom).txt, \
    graph.yaml


request_cpus = 1
request_memory = 2.5GB
request_disk = 2GB


queue chrom,output_vcf,output_stats from sim_variables
