
log = log/$(Cluster).log
error = log/$(Cluster).$(Process).err
output = log/$(Cluster).$(Process).out
requirements = (Target.HasCHTCStaging == true)
container_image = file:///staging/n/nwcollier/h2py-container.sif

request_cpus   = 1
request_memory = 4GB
request_disk   = 4GB

executable = parse_chromosome.sh
arguments = \
    --vcf merged.variants.chr$(chrom).vcf.gz \
    --L $(seqlen) \
    --bed mask_chr$(chrom).bed.gz \
    --rec_map $(recfile) \
    --rec_map_col $(mapcol) \
    --rec_pos_col $(poscol) \
    --pops populations_subset \
    --out $(outpkl) \
    --window_size 5000000 \
    --report

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = \
    ../../scripts/parse_chromosome.py, \
    ../../../data/vcf_files/merged/merged.variants.chr$(chrom).vcf.gz, \
    ../../../data/vcf_files/populations_subset, \
    $(bedpath)/mask_chr$(chrom).bed.gz, \
    $(recpath)/$(recfile)

queue chrom,seqlen,bedpath,recpath,recfile,poscol,mapcol,outpkl from variables.txt
