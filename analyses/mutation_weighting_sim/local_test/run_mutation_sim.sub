log = reports/job_$(Cluster)_$(Process).log
error = reports/job_$(Cluster)_$(Process).err
output = reports/job_$(Cluster)_$(Process).out
requirements = (Target.HasCHTCStaging == true)
container_image = file:///staging/nwcollier/dpluspy-container.sif


executable = run_mutation_sim.sh      
arguments = $(chrom) $(mask)


should_transfer_files = YES
when_to_transfer_output = ON_EXIT


transfer_input_files = \
    run_simulation.py, compute_stats.py, \
    data/recombination_maps/Behrer/sexavg_chr$(chrom).txt.gz, \
    data/mutation_maps/roulette_b37_1kb/roulette_1kb_chr22.csv.gz, \
    data/bed_files/filterbed_1e-4M_exon_buffer/mask_chr$(chrom).bed.gz, \
    data/intervals/chromosome_arms/arms_chr$(chrom).txt, \
    data/intervals/1e-4_exon_buffer_1.3Mb/intervals_chr$(chrom).txt


request_cpus = 1
request_memory = 8GB
request_disk = 2GB


queue chrom from chroms.txt
