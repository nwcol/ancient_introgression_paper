
log = log/$(Cluster).log
error = log/$(Cluster).$(Process).err
output = log/$(Cluster).$(Process).out
requirements = (Target.HasCHTCStaging == true)
container_image = file:///staging/n/nwcollier/h2py-container.sif

request_cpus   = 1
request_memory = 4GB
request_disk   = 4GB

executable = fit_model.sh
arguments = \
    --graph bherer_full.yaml \
    --params params_full.yaml \
    --data bherer_full_rep$(rep)_boot_h2.pkl \
    -o fit_rep$(rep)_trial$(trial).yaml \
    --perturb 0.1 \
    --threshold 0.1 \
    --jitter 0.01 \
    --report 500 \
    --max_iter 2000 \
    --max_runtime 150000


should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = \
    ../../scripts/fit_model.py, \
    ../models/bherer_full.yaml, \
    ../models/params_full.yaml, \
    ../simulation_outputs/bherer_full_rep$(rep)_boot_h2.pkl

queue rep,trial from variables.txt
