
log = log/$(Cluster).log
error = log/$(Cluster).$(Process).err
output = log/$(Cluster).$(Process).out
requirements = (Target.HasCHTCStaging == true)
container_image = file:///staging/n/nwcollier/h2py-container.sif

request_cpus   = 1
request_memory = 4GB
request_disk   = 4GB

executable = simulate_genome.sh
arguments = bherer_full.yaml pops.txt bherer_full_rep$(Process)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = simulate_genome.py, data.zip, ../models/bherer_full.yaml, pops.txt

queue 500
