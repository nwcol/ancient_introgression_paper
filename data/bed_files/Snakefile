            -o {output}
        """


rule subtract_exons_10kb:
    input:
        script = "../../tools/bedfile_difference.py",
        filter_bed = "filterbed_roulette/mask_chr{chrom}.bed.gz",
        buffer_bed = "buffers/exons_10kb_buffer/mask_chr{chrom}.bed.gz"
    output:
        "filterbed_10kb_exon_buffer/mask_chr{chrom}.bed.gz"
    shell:
        """
        python {input.script} \
            -i1 {input.filter_bed} \
            -i2 {input.buffer_bed} \
            -o {output}
        """


