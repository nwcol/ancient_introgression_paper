rule slop_exons_1_4M:
    input:
        script = "../../tools/bedfile_rslop.py",
        bed_file = "raw/exons_hg19/{chrom}_exons.bed.gz",
        map_file = "../recombination_maps/Bherer_b37/sexavg_chr{chrom}.txt"
    params:
        distance = "1e-4"
    output:
        "buffers/exons_1e-4M_buffer/mask_chr{chrom}.bed.gz"
    shell:
        """
        python {input.script} \
            -i {input.bed_file} \
            -r {input.map_file} \
            --buffer {params.distance} \
            -o {output}
        """


rule subtract_exons_1_4M:
    input:
        script = "../../tools/bedfile_difference.py",
        filter_bed = "filterbed_roulette/mask_chr{chrom}.bed.gz",
        buffer_bed = "buffers/exons_1e-4M_buffer/mask_chr{chrom}.bed.gz"
    output:
        "filterbed_1e-4M_exon_buffer/mask_chr{chrom}.bed.gz"
    shell:
        """
        python {input.script} \
            -i1 {input.filter_bed} \
            -i2 {input.buffer_bed} \
            -o {output}
        """

