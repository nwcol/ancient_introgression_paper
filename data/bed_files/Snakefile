"""

"""


configfile: "config.yaml"


rule all:
    input:
        expand('bed_files/African_mask/mask_chr{chrom}.bed', chrom=config['chroms']),
        expand('bed_files/African_roulette_mask/mask_chr{chrom}.bed', chrom=config['chroms']),
        expand('bed_files/Eurasian_mask/mask_chr{chrom}.bed', chrom=config['chroms']),
        expand('bed_files/Eurasian_roulette_mask/mask_chr{chrom}.bed', chrom=config['chroms'])


rule download_roulette_maps_hg19:
    # Download Roulette mutation maps in hg19.
    output: 
        "raw/roulette_hg19/hg19_chr{chrom}_rate_v5.2_TFBS_correction_sorted.vcf.gz" 
    params:
        link = ("http://genetics.bwh.harvard.edu/downloads/Vova/Roulette/hg19/"
                "hg19_chr{chrom}_rate_v5.2_TFBS_correction_sorted.vcf.gz"),
        prefix = "raw/roulette_hg19/"
    shell:
        """
        wget {params.link} -P {params.prefix}
        """


rule process_roulette_maps_hg19:
    input:
        "hg19_chr{chrom}_rate_v5.2_TFBS_correction_sorted.vcf.gz"
    output:
        vcf_file = "mutation_map_hg19_chr{chrom}.npy",
        bed_file = "mutation_map_hg19_chr{chrom}.bed.gz"
    shell:
        """
        python ../../tools/parse_mut_vcf.py -i {input} \
            -o {output.vcf_file} -b {output.bed_file}
        """





### BUILDING MASKS ###


rule mapslop_exon_masks:
    # Extend exonic intervals by 1e-5 M.
    input:
        script = '../tools/bed_mapslop.py',
        bed_file = 'raw/exonic_regions_b37/{chrom}_exons.bed',
        map_file = 'recombination_maps/Bherer_b37/sexavg_chr{chrom}.txt.gz'
    params:
        distance = '1e-5'
    output:
        'raw/exonic_regions_bg37_1e-5M/exons_1e-5M_chr{chrom}.bed.gz'
    shell:
        """
        python {input.script} \
            -bed {input.bed_file} \
            -map {input.map_file} \
            -dist {params.distance} \
            -out {output}
        """

rule intersect_filterbed_masks:
    # Intersect callability masks for ancient sequences and the 1KG strict mask.
    input:
        script = '../tools/bed_intersect.py',
        filterbeds = expand('raw/filterbed/{sample}/chr{{chrom}}_mask.bed.gz', 
            sample=config['ancient_samples']),
        strict_mask = 'raw/phase3_strict_mask/strict_chr{chrom}.bed.gz'
    output:
        'raw/filterbed_merged/chr{chrom}_mask.bed.gz'
    shell:
        "python {input.script} -i {input.filterbeds} -o {output}"

rule subtract_exons_Eurasian:
    input:
        script = '../tools/bed_difference.py',
        filterbed = 'raw/filterbed_merged/chr{chrom}_mask.bed.gz',
        slopped_exons = \
            'raw/exonic_regions_bg37_1e-5M/exons_1e-5M_chr{chrom}.bed.gz'
    output:
        'bed_files/Eurasian_mask/mask_chr{chrom}.bed'
    shell:
        """
        python {input.script} \
            -i1 {input.filterbed} \
            -i2 {input.slopped_exons} \
            -o {output}
        """

rule intersect_Eurasian_roulette:
    input:
        script = '../tools/bed_intersect.py',
        base_mask = 'bed_files/Eurasian_mask/mask_chr{chrom}.bed',
        roulette_mask = 'raw/roulette_hg19_coverage/mask_chr{chrom}.bed.gz'
    output:
        'bed_files/Eurasian_roulette_mask/mask_chr{chrom}.bed'
    shell:
        """
        python {input.script} \
            -i {input.base_mask} {input.roulette_mask} \
            -o {output}
        """

rule subtract_exons_African:
    # Subtract slopped exonic regions from the strict 1KG mask.
    input:
        script = '../tools/bed_difference.py',
        strict_mask = 'raw/phase3_strict_mask/strict_chr{chrom}.bed.gz',
        slopped_exons = 'raw/exonic_regions_bg37_1e-5M/exons_1e-5M_chr{chrom}.bed.gz'
    output:
        'bed_files/African_mask/mask_chr{chrom}.bed'
    shell:
        """
        python {input.script} \
            -i1 {input.strict_mask} \
            -i2 {input.slopped_exons} \
            -o {output}
        """

rule intersect_African_roulette:
    input:
        script = '../tools/bed_intersect.py',
        base_mask = 'bed_files/African_mask/mask_chr{chrom}.bed',
        roulette_mask = 'raw/roulette_hg19_coverage/mask_chr{chrom}.bed.gz'
    output:
        'bed_files/African_roulette_mask/mask_chr{chrom}.bed'
    shell:
        """
        python {input.script} \
            -i {input.base_mask} {input.roulette_mask} \
            -o {output}
        """


