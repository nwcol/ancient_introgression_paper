        """


rule slop_exons_1eneg4M:
    input:
        script = "../../tools/map_slop_bed_file.py",
        exons = "ccds_exons/exons_chr{chrom}.bed",
        map_file = "../recombination_maps/Bherer/sexavg_chr{chrom}.txt.gz"
    params:
        buffer = "1e-4"
    output:
        "buffers/1e-4M/mask_chr{chrom}.bed.gz"
    shell:
        """
        python {input.script} \
            -i {input.exons} \
            -r {input.map_file} \
            --buffer {params.buffer} \
            -o {output}
        """


rule slop_exons_1eneg4M_zhou:
    input:
        script = "../../tools/map_slop_bed_file_zhou.py",
        exons = "ccds_exons/exons_chr{chrom}.bed",
        map_file = "../recombination_maps/Zhou/JHS/JHS.chr{chrom}.1000.plinkmap.txt.gz"
    params:
        buffer = "1e-4"
    output:
        "buffers/1e-4M_zhou/mask_chr{chrom}.bed.gz"
    shell:
        """
        python {input.script} \
            -i {input.exons} \
            -r {input.map_file} \
            --buffer {params.buffer} \
            -o {output}
        """


rule slop_exons_1eneg3M:
    input:
        script = "../../tools/map_slop_bed_file.py",
        exons = "ccds_exons/exons_chr{chrom}.bed",
        map_file = "../recombination_maps/Bherer/sexavg_chr{chrom}.txt.gz"
    params:
        buffer = "1e-3"
    output:
        "buffers/1e-3M/mask_chr{chrom}.bed.gz"
    shell:
        """
        python {input.script} \
            -i {input.exons} \
            -r {input.map_file} \
            --buffer {params.buffer} \
            -o {output}
        """


rule subtract_cds_buffers:
    input:
        script = "../../tools/subtract_bed_files.py",
        accessible = "accessible/mask_chr{chrom}.bed.gz",
        exon_buffers = "buffers/{buffer}/mask_chr{chrom}.bed.gz"
    output:
        "accessible_{buffer}_ccds_flank/mask_chr{chrom}.bed.gz"
    shell:
        """
        python {input.script} \
            -i1 {input.accessible} \
            -i2 {input.exon_buffers} \
            -o {output}
        """




