

configfile: "../config.yaml"
CHROMS = list(range(1, 23))


rule all:
    input: 
        expand("roulette/map_chr{chrom}.npy", chrom=CHROMS),
        #expand("roulette_1kb/map_chr{chrom}.csv.gz", chrom=CHROMS),
        #expand("roulette_10kb/map_chr{chrom}.csv.gz", chrom=CHROMS)
        

rule parse_mutation_maps:
    input:
        script = "../../tools/parse_roulette_vcf.py",
        infile = config["roulette_dir"] + "hg19_chr{chrom}_rate_v5.2_TFBS_correction_sorted.vcf.gz"
    output:
        "roulette/map_chr{chrom}.npy",
    shell:
        """
        python {input.script} -i {input.infile} -o {output}
        """


